{
  "name": "@zyvnox/vue-pack",
  "version": "0.1.1",
  "private": false,
  "description": "A comprehensive, schema-driven Vue 3 component library built with TypeScript and Vite.",
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui-library",
    "form-generator",
    "datatable",
    "typescript",
    "vite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyvnox/vue-pack.git"
  },
  "bugs": {
    "url": "https://github.com/zyvnox/vue-pack/issues"
  },
  "homepage": "https://github.com/zyvnox/vue-pack#readme",
  "license": "MIT",
  "author": "zyvnox",
  "funding": [
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/zyvnox"
    },
    {
      "type": "custom",
      "url": "https://saweria.co/zyvnox"
    }
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/zyvnox-vue-pack.cjs.js",
  "module": "./dist/zyvnox-vue-pack.es.js",
  "types": "./dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "vue": [
        "dist/types/plugin/vue.plugin.d.ts"
      ],
      "init": [
        "dist/types/init.d.ts"
      ],
      "indexedDB": [
        "dist/types/lib/indexedDB.d.ts"
      ],
      "secureFetch": [
        "dist/types/lib/secureFetch.d.ts"
      ],
      "config": [
        "dist/types/config.d.ts"
      ],
      "components": [
        "dist/types/components/index.d.ts"
      ],
      "type": [
        "dist/types/configs/types/index.d.ts"
      ]
    }
  },
  "unpkg": "./dist/cdn/vue-pack.umd.js",
  "jsdelivr": "./dist/cdn/vue-pack.umd.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/zyvnox-vue-pack.es.js",
      "require": "./dist/zyvnox-vue-pack.cjs.js"
    },
    "./vue": {
      "types": "./dist/types/plugin/vue.plugin.d.ts",
      "import": "./dist/vue.es.js",
      "require": "./dist/vue.cjs.js"
    },
    "./init": {
      "types": "./dist/types/init.d.ts",
      "import": "./dist/init.es.js",
      "require": "./dist/init.cjs.js"
    },
    "./indexedDB": {
      "types": "./dist/types/lib/indexedDB.d.ts",
      "import": "./dist/indexedDB.es.js",
      "require": "./dist/indexedDB.cjs.js"
    },
    "./secureFetch": {
      "types": "./dist/types/lib/secureFetch.d.ts",
      "import": "./dist/secureFetch.es.js",
      "require": "./dist/secureFetch.cjs.js"
    },
    "./config": {
      "types": "./dist/types/config.d.ts",
      "import": "./dist/config.es.js",
      "require": "./dist/config.cjs.js"
    },
    "./components": {
      "types": "./dist/types/components/index.d.ts",
      "import": "./dist/components.es.js",
      "require": "./dist/components.cjs.js"
    },
    "./type": {
      "types": "./dist/types/configs/types/index.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./cdn": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/cdn/vue-pack.es.js",
      "default": "./dist/cdn/vue-pack.umd.js"
    },
    "./cdn/*": "./dist/cdn/*"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts --port=5173",
    "dev:site": "vite --config vite.config.ts --port=5173",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "format": "prettier --write src/",
    "type:emit": "vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "uno:build": "unocss \"src/**/*.{vue,ts,js}\" -o src/style.css",
    "test": "vitest run --config vitest.config.ts",
    "site": "cd site && npm run dev",
    "site:build": "cd site && npm run build",
    "site:preview": "cd site && npm run preview"
  },
  "dependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@types/lodash-es": "^4.17.12",
    "dompurify": "^3.2.6",
    "lodash-es": "^4.18.1",
    "lodash.isequal": "^4.5.0",
    "quill": "2.0.2"
  },
  "peerDependencies": {
    "leaflet": "^1.9.4",
    "vue": "^3.5.18",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@tsconfig/node21": "^21.0.5",
    "@tsconfig/node22": "^22.0.2",
    "@types/leaflet": "^1.9.21",
    "@types/lodash.isequal": "^4.5.8",
    "@types/node": "^22.19.10",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/language-core": "^3.3.13",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "^29.1.1",
    "license-checker-rseidelsohn": "^4.4.2",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "quill-resize-module": "^2.1.0-beta.0",
    "sass-embedded": "^1.70.0",
    "typescript": "5.6",
    "unocss": "^66.6.0",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^5.0.3",
    "vue-tsc": "2.1"
  }
}
